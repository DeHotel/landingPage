# Copiar como .env.deploy y completar con los datos FTP del hosting.
FTP_HOST=ftp.dehotel.cl
FTP_PORT=21
FTP_USER=
FTP_PASSWORD=
# true para FTPS (FTP sobre TLS), si el hosting lo soporta
FTP_SECURE=true
# true solo si el certificado del FTP no coincide con el host (común en hosting compartido)
FTP_INSECURE_TLS=false
# Carpeta pública del sitio en el servidor
FTP_REMOTE_DIR=/public_html
